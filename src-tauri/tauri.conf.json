{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TS4 Mod Manager",
  "version": "0.1.0",
  "identifier": "com.ts4.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TS4 Mod Manager",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Linux-first Sims 4 mod manager",
    "longDescription": "A local-first Linux desktop mod manager for The Sims 4 with safe filesystem operations, metadata, themes, trash restore, and Proton path support."
  }
}
