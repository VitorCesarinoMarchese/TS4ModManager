{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TS4 Mod Manager",
  "version": "0.1.0",
  "identifier": "com.ts4.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TS4 Mod Manager",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
